{
    "name": "unidia/application",
    "description": "UniDia Healthcare Management System",
    "version": "1.0.1",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpmailer/phpmailer": "^6.5",
        "dompdf/dompdf": "^2.0",
        "mpdf/mpdf": "^8.1",
        "picqer/php-barcode-generator": "^2.4"
    },
    "autoload": {
        "psr-4": {
